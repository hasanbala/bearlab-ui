{
  "name": "@bearlab/pricing",
  "version": "1.1.4",
  "description": "Bearlab UI Pricing Component",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "cd ../../ && PACKAGE_NAME=pricing rollup -c tools/rollup.config.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bearlab/button": "^1.2.3",
    "classnames": "^2.5.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": [
    "react",
    "ui",
    "component",
    "ui-library",
    "pricing",
    "pricing-table",
    "subscription",
    "bearlab",
    "bearlab-ui"
  ],
  "author": "hasanbala",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hasanbala/bearlab-ui.git",
    "directory": "packages/pricing"
  },
  "homepage": "https://bearlab-ui.vercel.app/packages/pricing/preview",
  "publishConfig": {
    "access": "public"
  }
