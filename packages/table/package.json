{
  "name": "@bearlab/table",
  "version": "2.0.0",
  "description": "Bearlab UI Table Component",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "cd ../../ && PACKAGE_NAME=table rollup -c tools/rollup.config.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bearlab/button": "^2.0.0",
    "@bearlab/checkbox": "^1.2.5",
    "@bearlab/loading": "^1.3.0",
    "@bearlab/radio": "^1.2.4",
    "@bearlab/skeleton": "^1.2.4",
    "classnames": "^2.5.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": [
    "react",
    "ui",
    "component",
    "ui-library",
    "table",
    "datatable",
    "data-grid",
    "pagination",
    "row-selection",
    "bearlab",
    "bearlab-ui",
    "nextjs",
    "next",
    "ssr",
    "server-components"
  ],
  "author": "hasanbala",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hasanbala/bearlab-ui.git",
    "directory": "packages/table"
  },
  "homepage": "https://bearlab-ui.vercel.app/packages/table/preview",
  "publishConfig": {
    "access": "public"
  }
}
