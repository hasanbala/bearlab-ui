{
  "name": "@bearlab/button",
  "version": "3.1.0",
  "description": "Bearlab UI Button Component",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "cd ../../ && PACKAGE_NAME=button rollup -c tools/rollup.config.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "lucide-react": "^1.61.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": [
    "react",
    "ui",
    "button",
    "component",
    "bearlab",
    "bearlab-ui",
    "nextjs",
    "next",
    "ssr",
    "server-components"
  ],
  "author": "hasanbala",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hasanbala/bearlab-ui.git",
    "directory": "packages/button"
  },
  "homepage": "https://bearlab-ui.vercel.app/packages/button/preview",
  "publishConfig": {
    "access": "public"
  }
}
