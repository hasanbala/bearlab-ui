{
  "name": "@bearlab/query-select",
  "version": "1.1.4",
  "description": "Bearlab UI Query Select Component",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "cd ../../ && PACKAGE_NAME=query-select rollup -c tools/rollup.config.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": [
    "react",
    "ui",
    "component",
    "ui-library",
    "query-select",
    "autocomplete",
    "select",
    "dropdown",
    "async-select",
    "bearlab",
    "bearlab-ui"
  ],
  "author": "hasanbala",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hasanbala/bearlab-ui.git",
    "directory": "packages/query-select"
  },
  "homepage": "https://bearlab-ui.vercel.app/packages/query-select/preview",
  "publishConfig": {
    "access": "public"
  }
}
